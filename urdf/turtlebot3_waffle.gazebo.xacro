<?xml version="1.0" ?>
<!--
  turtlebot3_waffle.gazebo.xacro

  Gazebo 전용 플러그인 정의 파일. 로봇의 물리적 구조(joint/link)는 전혀 포함하지
  않으며, turtlebot3_waffle.urdf.xacro가 이 파일을 include해서 사용함.

  기존 turtlebot3_gazebo/models/turtlebot3_waffle/model.sdf에 정의되어 있던
  플러그인들(diff_drive, imu, lds ray sensor, camera, joint_state_publisher)을
  그대로 이식했고, VLP-16(3D LiDAR)용 gpu_ray 플러그인을 신규로 추가함.

  네임스페이스: ${namespace} 프로퍼티는 이 파일을 include하는
  turtlebot3_waffle.urdf.xacro에서 이미 정의되어 있어야 함.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ==================================================================
       1. 차동 구동 플러그인 (기존 model.sdf의 turtlebot3_diff_drive 이식)
       ================================================================== -->
  <gazebo>
    <plugin name="turtlebot3_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>${namespace}</namespace>
      </ros>

      <update_rate>30</update_rate>

      <!-- wheels -->
      <left_joint>${namespace}wheel_left_joint</left_joint>
      <right_joint>${namespace}wheel_right_joint</right_joint>

      <!-- kinematics -->
      <wheel_separation>0.287</wheel_separation>
      <wheel_diameter>0.066</wheel_diameter>

      <!-- limits -->
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>

      <command_topic>cmd_vel</command_topic>

      <!-- output -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>

      <odometry_topic>odom</odometry_topic>
      <odometry_frame>${namespace}odom</odometry_frame>
      <robot_base_frame>${namespace}base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- ==================================================================
       2. 조인트 상태 퍼블리셔 (기존 model.sdf의 turtlebot3_joint_state 이식)
       ================================================================== -->
  <gazebo>
    <plugin name="turtlebot3_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>${namespace}</namespace>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>${namespace}wheel_left_joint</joint_name>
      <joint_name>${namespace}wheel_right_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ==================================================================
       3. IMU 센서 (기존 model.sdf의 tb3_imu 이식)
       ================================================================== -->
  <gazebo reference="${namespace}imu_link">
    <sensor name="tb3_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <plugin name="turtlebot3_imu" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>${namespace}</namespace>
          <remapping>~/out:=imu</remapping>
        </ros>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ==================================================================
       4. 2D LDS 라이다 (기존 model.sdf의 hls_lfcd_lds 이식)
       주행/AMCL 위치 추정 전용. base_scan link에 부착됨(scan_joint로 이미 연결됨).
       ================================================================== -->
  <gazebo reference="${namespace}base_scan">
    <sensor name="hls_lfcd_lds" type="gpu_ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>5</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.000000</resolution>
            <min_angle>0.000000</min_angle>
            <max_angle>6.280000</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.120000</min>
          <max>3.5</max>
          <resolution>0.015000</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="turtlebot3_laserscan" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>${namespace}</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>${namespace}base_scan</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ==================================================================
       5. Velodyne VLP-16 (3D LiDAR) — GPU Ray 방식
       바닥 평탄도 측정 전용. velodyne_link에 부착됨(velodyne_joint로 이미 연결됨).
       'heatmap만 잘 나오면 된다'는 전제 하에 동작 확인이 가능한 수준으로 구성하였음.
       실제 VLP-16 스펙(수직 16채널, ±15도 FOV, 100m 범위)을 기반으로 하되 시뮬레이션 성능 고려.
       ================================================================== -->
  <gazebo reference="${namespace}velodyne_link">
    <sensor name="velodyne_vlp16" type="gpu_ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>900</samples>
            <resolution>1.000000</resolution>
            <min_angle>-3.141592</min_angle>
            <max_angle>3.141592</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1.000000</resolution>
            <!-- VLP-16 공칭 수직 FOV: -15deg ~ +15deg -->
            <min_angle>-0.2618</min_angle>
            <max_angle>0.2618</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.3</min>
          <max>100.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="velodyne_gpu_ray_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>${namespace}</namespace> 
          <remapping>~/out:=velodyne_points</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>${namespace}velodyne_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ==================================================================
       6. RGB 카메라 (기존 model.sdf의 camera_driver 이식)
       ================================================================== -->
  <gazebo reference="${namespace}camera_rgb_frame">
    <sensor name="camera" type="camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <camera name="intel_realsense_r200">
        <horizontal_fov>1.02974</horizontal_fov>
        <image>
          <width>1920</width>
          <height>1080</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="camera_driver" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>${namespace}</namespace>
        </ros>
      </plugin>
    </sensor>
  </gazebo>

</robot>
